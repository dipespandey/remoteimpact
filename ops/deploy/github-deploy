#!/usr/bin/env python3
"""Accept only current main's exact commit through the restricted GitHub SSH key."""
import os
from pathlib import Path
import re
import subprocess
import sys

command = os.environ.get('SSH_ORIGINAL_COMMAND', '')
match = re.fullmatch(r'\s*cd /opt/easyclaw &&\s*git -C repo fetch origin ([0-9a-f]{40}) &&\s*/opt/easyclaw/deploy\.sh --ref \1( --allow-migrations)?\s*', command)
if not match:
    sys.exit('Only the Remote Impact SHA deployment command is allowed.')
root = Path('/opt/easyclaw')
mirror = root / 'github-source.git'
sha = match.group(1)
subprocess.run(['git', '-C', str(mirror), 'fetch', 'origin', 'main:refs/remotes/origin/main'], check=True)
main = subprocess.check_output(['git', '-C', str(mirror), 'rev-parse', 'refs/remotes/origin/main'], text=True).strip()
if sha != main:
    sys.exit('Refusing a superseded or non-main commit; production unchanged.')
args = [str(root / 'deploy.sh'), '--ref', sha]
if match.group(2):
    args.append('--allow-migrations')
subprocess.run(args, check=True, cwd=root)
