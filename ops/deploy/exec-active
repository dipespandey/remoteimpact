#!/usr/bin/env python3
"""Run a scheduled command in the active release; hold a drain lock for its lifetime."""
import fcntl
import json
from pathlib import Path
import subprocess
import sys

root = Path('/opt/easyclaw/releases')
root.mkdir(exist_ok=True)
# Resolve once under a shared lock, then recheck after locking to avoid a cutover race.
while True:
    state = root / 'state.json'
    cid = json.loads(state.read_text())['active']['id'] if state.exists() else subprocess.check_output(
        ['docker', 'inspect', '-f', '{{.Id}}', 'easyclaw-web-1'], text=True).strip()
    lock = open(root / (cid + '.jobs.lock'), 'a')
    fcntl.flock(lock, fcntl.LOCK_SH)
    latest = json.loads(state.read_text())['active']['id'] if state.exists() else cid
    if latest == cid:
        break
    lock.close()
raise SystemExit(subprocess.run(['docker', 'exec', cid, *sys.argv[1:]]).returncode)
