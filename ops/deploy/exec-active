#!/usr/bin/env python3
"""Run scheduled work in the active release and stop a drained previous release."""
import fcntl
import json
from pathlib import Path
import subprocess
import sys


def execute(args, root=Path('/opt/easyclaw/releases')):
    root.mkdir(exist_ok=True)
    while True:
        state = root / 'state.json'
        cid = json.loads(state.read_text())['active']['id'] if state.exists() else subprocess.check_output(
            ['docker', 'inspect', '-f', '{{.Id}}', 'easyclaw-web-1'], text=True).strip()
        lock = open(root / (cid + '.jobs.lock'), 'a')
        fcntl.flock(lock, fcntl.LOCK_SH)
        latest = json.loads(state.read_text())['active']['id'] if state.exists() else cid
        if latest == cid:
            break
        lock.close()
    try:
        result = subprocess.run(['docker', 'exec', cid, *args]).returncode
    finally:
        lock.close()
    latest = json.loads(state.read_text())['active']['id'] if state.exists() else cid
    if latest != cid:
        try:
            subprocess.run([str(root.parent / 'deploy.sh'), 'stop-previous'],
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except OSError:
            pass
    return result


if __name__ == '__main__':
    raise SystemExit(execute(sys.argv[1:]))
