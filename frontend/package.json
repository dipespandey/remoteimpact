{
  "name": "remoteimpact-frontend",
  "private": true,
  "description": "Builds static/tailwind.min.css from the Django templates.",
  "scripts": {
    "build": "node build-assets.mjs && tailwindcss -c tailwind.config.js -i ui.css -o ../static/tailwind.min.css --minify",
    "watch": "node build-assets.mjs && tailwindcss -c tailwind.config.js -i ui.css -o ../static/tailwind.min.css --watch"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@tailwindcss/forms": "0.5.9",
    "@tailwindcss/typography": "0.5.15",
    "alpinejs": "3.17.4",
    "htmx.org": "1.9.10",
    "tailwindcss": "3.4.17"
  },
  "overrides": {
    "postcss-selector-parser": "^7.1.6"
  }
}
