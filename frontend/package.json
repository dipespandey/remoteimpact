{
  "name": "remoteimpact-frontend",
  "private": true,
  "description": "Builds static/tailwind.min.css from the Django templates.",
  "scripts": {
    "build": "tailwindcss -c tailwind.config.js -i ui.css -o ../static/tailwind.min.css --minify",
    "watch": "tailwindcss -c tailwind.config.js -i ui.css -o ../static/tailwind.min.css --watch"
  },
  "devDependencies": {
    "@tailwindcss/forms": "0.5.9",
    "@tailwindcss/typography": "0.5.15",
    "tailwindcss": "3.4.17"
  }
}
